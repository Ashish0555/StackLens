# Keep real credentials only in .env, which is excluded from Git and Docker builds.
OPENAI_API_KEY=
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=postgresql+psycopg://stacklens:stacklens@localhost:5432/stacklens
POSTGRES_PASSWORD=stacklens
SESSION_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT=120/minute
RATE_LIMIT_STORAGE=redis://localhost:6379/1
# Optional legacy administrator API. Empty disables these routes.
API_KEY=
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
INGESTION_MODE=local
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EVIDENCE_JUDGE_ENABLED=true
VALIDATION_RETRIES=1
MAX_CONVERSATION_TURNS=8
MAX_CONVERSATION_CHARS=30000
MAX_REVIEW_FILES=100
MAX_REVIEW_FILE_BYTES=500000
MAX_REVIEW_CONTEXT_CHARS=120000
# Optional cloud tracing; traces may contain private document text.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
